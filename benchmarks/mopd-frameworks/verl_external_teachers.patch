+class ExternalSGLangTeacherClient:
+    """Minimal serializable client for a pre-launched SGLang teacher."""
+
+    def __init__(self, key: str, url: str):
+        self.key = key
+        self.url = url
+
+    async def generate(
+        self,
+        request_id,
+        *,
+        prompt_ids,
+        sampling_params,
+        image_data=None,
+        video_data=None,
+        audio_data=None,
+        mm_processor_kwargs=None,
+        **kwargs,
+    ):
+        del video_data, audio_data, mm_processor_kwargs, kwargs
+        logger.warning(
+            "external_teacher_route key=%s tokens=%d",
+            self.key,
+            len(prompt_ids),
+        )
+        params = dict(sampling_params)
+        prompt_logprobs = params.pop("prompt_logprobs", None)
+        if "max_tokens" in params:
+            params["max_new_tokens"] = params.pop("max_tokens")
+        request = {
+            "rid": request_id,
+            "input_ids": list(prompt_ids),
+            "sampling_params": params,
+            "return_logprob": prompt_logprobs is not None,
+            "image_data": image_data,
+        }
+        if prompt_logprobs is not None:
+            request["logprob_start_len"] = 0
+            if prompt_logprobs > 0:
+                request["top_logprobs_num"] = prompt_logprobs
+
+        timeout = aiohttp.ClientTimeout(total=600)
+        async with aiohttp.ClientSession(timeout=timeout) as session:
+            async with session.post(self.url, json=request) as response:
+                response.raise_for_status()
+                output = await response.json()
+
+        extra_fields = {}
+        if prompt_logprobs is not None:
+            meta_info = output.get("meta_info", {})
+            input_token_logprobs = meta_info.get("input_token_logprobs") or []
+            if prompt_logprobs > 0:
+                input_top_logprobs = meta_info.get("input_top_logprobs") or []
+            teacher_ids = []
+            teacher_logprobs = []
+            for position in range(1, len(input_token_logprobs)):
+                if prompt_logprobs == 0:
+                    logprob, token_id, _ = input_token_logprobs[position]
+                    teacher_ids.append([int(token_id)])
+                    teacher_logprobs.append([float(logprob)])
+                else:
+                    entries = input_top_logprobs[position]
+                    teacher_ids.append([int(token_id) for _, token_id, _ in entries])
+                    teacher_logprobs.append([float(logprob) for logprob, _, _ in entries])
+            width = max(prompt_logprobs, 1)
+            teacher_ids.append([0] * width)
+            teacher_logprobs.append([0.0] * width)
+            if len(teacher_ids) != len(prompt_ids):
+                raise ValueError(
+                    f"SGLang returned {len(teacher_ids)} prompt positions for {len(prompt_ids)} input IDs"
+                )
+            extra_fields["prompt_ids"] = teacher_ids
+            extra_fields["prompt_logprobs"] = teacher_logprobs
+
+        return TokenOutput(
+            token_ids=list(output.get("output_ids", [])),
+            log_probs=None,
+            stop_reason=(output.get("meta_info", {}).get("finish_reason") or {}).get("type"),
+            extra_fields=extra_fields,
+        )
+
+
+class ExternalMultiTeacherModelManager:
+    """Opt-in two-GPU benchmark adapter using external SGLang endpoints."""
+
+    def __init__(self, config: DictConfig):
+        self.config = config
+        self.distillation_config: DistillationConfig = omega_conf_to_dataclass(config.distillation)
+        urls = json.loads(os.environ["VERL_EXTERNAL_TEACHER_URLS"])
+        expected = set(self.distillation_config.teacher_models)
+        if set(urls) != expected:
+            raise ValueError(f"external teacher URL keys {sorted(urls)} != configured keys {sorted(expected)}")
+        self.urls = urls
+        logger.warning("Using externally managed MOPD teachers: %s", sorted(urls))
+
+    def get_client(self):
+        return {key: ExternalSGLangTeacherClient(key, url) for key, url in self.urls.items()}
