     return args.sglang_router_policy in ("consistent_hashing", "manual")
 
 
+def _student_opd_top_k(args) -> int:
+    if not getattr(args, "use_opd", False) or getattr(args, "opd_top_k_strategy", "only-student") == "only-teacher":
+        return 0
+    return max(0, getattr(args, "opd_log_prob_top_k", 0) or 0)
+
+
+def _retain_student_opd_scores(args, sample, output) -> None:
+    if not _student_opd_top_k(args):
+        return
+    meta = output["meta_info"]
+    tokens = meta.get("output_token_logprobs") or []
+    rows = meta.get("output_top_logprobs")
+    if not tokens and rows is None:
+        return
+    if rows is None or len(rows) != len(tokens):
+        raise ValueError("Student OPD top-k scores must align with each generated response token")
+    if any(len(row) != _student_opd_top_k(args) for row in rows):
+        raise ValueError("Student OPD response has an incomplete candidate support")
+    if sample.metadata is None:
+        sample.metadata = {}
+    sample.metadata.setdefault("opd_student_top_logprobs", []).extend(rows)
+
